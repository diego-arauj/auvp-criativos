{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/hooks\"; ./guarda.cmd; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/hooks\"; ./guarda.cmd; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
